# Copy this file to .env and supply environment-specific secrets locally.
# Never commit real provider credentials, webhook URLs, or encryption keys.
APP_NAME=Support Ticket Agent
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/support_tickets
# Cloud Run only; also attach this instance to the service.
CLOUD_SQL_CONNECTION_NAME=
REDIS_URL=redis://localhost:6379/0

# Required by production API/operator routes. Entered by operators in the UI;
# never compile this value into the frontend bundle.
OPERATOR_API_KEY=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAQ_SOURCE_PATH=app/knowledge/faq.json
FAQ_INDEX_PATH=data/faq_index

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_CREDENTIALS_ENCRYPTION_KEY=

SLACK_WEBHOOK_URL=
MAX_RETRY_ATTEMPTS=4
RETRY_BACKOFF_BASE_SECONDS=2

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.85
FAQ_SIMILARITY_THRESHOLD=0.85
